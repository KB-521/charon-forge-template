{
  "extends": "./src/.umi/tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "config/**/*",
    "types/**/*",
    "typings.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ]
}
