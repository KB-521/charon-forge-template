{
  "name": "__PROJECT_NAME__",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.18.3 <11"
  },
  "scripts": {
    "dev": "cross-env APP_ENV=local next dev --webpack",
    "dev:test": "cross-env APP_ENV=test next dev --webpack",
    "build": "cross-env APP_ENV=production next build --webpack",
    "build:local": "cross-env APP_ENV=local next build --webpack",
    "build:test": "cross-env APP_ENV=test next build --webpack",
    "build:ci": "cross-env APP_ENV=ci next build --webpack",
    "build:production": "cross-env APP_ENV=production next build --webpack",
    "start": "cross-env APP_ENV=production next start",
    "start:test": "cross-env APP_ENV=test next start",
    "start:local": "cross-env APP_ENV=local next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@ant-design/cssinjs": "1.24.0",
    "@ant-design/nextjs-registry": "1.2.0",
