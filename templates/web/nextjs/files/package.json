    "antd": "5.24.5",
    "axios": "1.20.0",
    "axios-cache-interceptor": "1.5.3",
    "clsx": "2.1.1",
    "cross-env": "7.0.3",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "@charonix/eslint-config": "1.2.0",
    "@types/node": "22.10.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
